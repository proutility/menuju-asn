{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions"
  },
  "hosting": {
    "site": "menuju-asn",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "README.md"
    ],
    "headers": [
      {
        "source": "/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/menuju-asn-bot",
        "function": {
          "functionId": "menujuAsnBot",
          "region": "asia-southeast2"
        }
      },
      {
        "source": "/api/midtrans",
        "function": {
          "functionId": "midtransApi",
          "region": "asia-southeast2"
        }
      },
      {
        "source": "/api/midtrans-webhook",
        "function": {
          "functionId": "midtransWebhook",
          "region": "asia-southeast2"
        }
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
